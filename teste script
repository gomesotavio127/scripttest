local function EncerrarDrag()
    S.Dragging =
        false

    S.DragStart =
        nil

    S.StartPosition =
        nil

    if S.DragEndConnection then
        pcall(function()
            S.DragEndConnection:Disconnect()
        end)

        S.DragEndConnection =
            nil
    end
end

local function IniciarDrag(
    input
)
    if S.GuiFechada
        or S.Minimized then

        return
    end

    if input.UserInputType ~=
        Enum.UserInputType.MouseButton1
        and input.UserInputType ~=
        Enum.UserInputType.Touch then

        return
    end

    if input.Target then
        local target =
            input.Target

        if target
            and (
                target:IsDescendantOf(
                    minimizeButton
                )
                or target:IsDescendantOf(
                    closeButton
                )
            ) then

            return
        end
    end

    S.Dragging =
        true

    S.DragStart =
        input.Position

    S.StartPosition =
        UI.Window.Position

    if S.DragEndConnection then
        pcall(function()
            S.DragEndConnection:Disconnect()
        end)
    end

    S.DragEndConnection =
        input.Changed:Connect(
            function()
                if input.UserInputState ==
                    Enum.UserInputState.End then

                    EncerrarDrag()
                end
            end
        )
end

Conectar(
    UI.Header.InputBegan,
    IniciarDrag
)

Conectar(
    G.UserInputService.InputChanged,
    function(input)
        if not S.Dragging
            or S.GuiFechada
            or S.Minimized then

            return
        end

        if input.UserInputType ~=
            Enum.UserInputType.MouseMovement
            and input.UserInputType ~=
            Enum.UserInputType.Touch then

            return
        end

        if not S.DragStart
            or not S.StartPosition then

            return
        end

        local delta =
