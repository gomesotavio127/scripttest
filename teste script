local function EsperarNaPorta()
    UI.FarmDoorLabel.Text =
        "Porta: iniciando contagem"

    UI.FarmDoorBar.Size =
        UDim2.new(
            1,
            0,
            1,
            0
        )

    if S.DoorTween then
        pcall(function()
            S.DoorTween:Cancel()
        end)

        S.DoorTween =
            nil
    end

    for i =
        CFG.DOOR_WAIT,
        1,
        -1 do

        if not S.Running
            or not VerificarCarrinho() then

            return false
        end

        DefinirStatus(
            "Porta aberta · aguardando " ..
            tostring(i) ..
            "s"
        )

        UI.FarmDoorLabel.Text =
            "Porta: " ..
            tostring(i) ..
            "s"

        UI.FarmDoorLabel.TextTransparency =
            0

        UI.FarmDoorBar.Size =
            UDim2.new(
                1,
                0,
                1,
                0
            )

        S.DoorTween =
            Tween(
                UI.FarmDoorBar,
                1,
                {
                    Size =
                        UDim2.new(
                            0,
                            0,
                            1,
                            0
                        )
                },
                Enum.EasingStyle.Linear
            )

        task.wait(1)
    end

    UI.FarmDoorLabel.Text =
        "Porta: concluída"

    UI.FarmDoorBar.Size =
        UDim2.new(
            0,
            0,
            1,
            0
        )

    return S.Running
end

-- ============================================================
-- BOTÃO VERDE
-- ============================================================

local function PressionarBotaoVerde()
    if not VerificarCarrinho() then
        return false
    end

    DefinirStatus(
        "Indo para o Ponto 3..."
    )

    if not MoverCarrinho(
        S.ActiveCart,
        PONTO_3
    ) then

        DefinirStatus(
            "Falha ao mover para Ponto 3",
            "error"
        )

        return false
    end

    task.wait(
        CFG.POINT3_SETTLE_DELAY
    )

    if not S.Running
        or not VerificarCarrinho() then

        return false
    end

    for attempt =
        1,
        CFG.GREEN_RETRIES do

        if not S.Running then
            return false
        end

        if not VerificarCarrinho() then
            return false
        end

        DefinirStatus(
            "Procurando botão verde... (" ..
            tostring(attempt) ..
            "/" ..
            tostring(
                CFG.GREEN_RETRIES
            ) ..
            ")"
        )

        local interaction =
            EncontrarInteracaoVerde(
                PONTO_3,
                CFG.GREEN_RADIUS
            )

        if interaction
            and AtivarInteracao(
                interaction
            ) then

            DefinirStatus(
                "Botão verde apertado!",
                "success"
            )

            return true
        end

        if interaction then
            DefinirStatus(
                "Falha ao apertar botão verde",
                "warn"
            )
        else
            DefinirStatus(
                "Botão verde não encontrado",
                "warn"
            )
        end

        if attempt <
            CFG.GREEN_RETRIES then

            task.wait(
                CFG.GREEN_RETRY_WAIT
            )
        end
    end

    DefinirStatus(
        "Botão verde não encontrado após retries",
        "error"
    )

    return false
end

-- ============================================================
-- AGUARDAR ESTÁGIO
-- ============================================================

local function EsperarEstagio(
    targets
)
    while S.Running do
        if S.ActiveCart
            and not VerificarCarrinho() then

            return nil
        end

        local stage,
            source =
            DetectarEstagioAtual()

        if stage then
            DefinirVisualEstagio(
                stage,
                source
            )

            if targets[stage] then
                print(
                    "[CAR RIDE] ESTÁGIO:",
                    stage,
                    "|",
                    source or ""
                )

                return stage
            end
        end

        task.wait(
            CFG.STAGE_POLL_INTERVAL
        )
    end

    return nil
end

-- ============================================================
-- ROTA STARTING
-- ============================================================

local function ExecutarStarting()
    if not VerificarCarrinho() then
        return false
    end

    DefinirStatus(
        "Starting → Ponto 1"
    )

    if not MoverCarrinho(
        S.ActiveCart,
        PONTO_1,
        FRENTE_PONTO_1
    ) then

        DefinirStatus(
            "Falha no Ponto 1",
            "error"
        )

        return false
    end

    if not EsperarNaPorta() then
        return false
    end

    if not VerificarCarrinho() then
        return false
    end

    DefinirStatus(
        "Saindo do Ponto 1"
    )

    if not MoverCarrinho(
        S.ActiveCart,
        FRENTE_PONTO_1,
        PONTO_2
    ) then

        DefinirStatus(
            "Falha ao sair do Ponto 1",
            "error"
        )

        return false
    end

    local stage =
        EsperarEstagio(
            {
                [SUFFERING] = true,
                [SUFFERED] = true
            }
        )

    if not S.Running then
        return false
    end

    if stage ==
        SUFFERED then

        return true
    end

    if not VerificarCarrinho() then
        return false
    end

    DefinirStatus(
        "Suffering → Ponto 2"
    )

    if not MoverCarrinho(
        S.ActiveCart,
        PONTO_2,
        FRENTE_PONTO_2
    ) then

        DefinirStatus(
            "Falha no Ponto 2",
            "error"
        )

        return false
    end

    if not EsperarNaPorta() then
        return false
    end

    if not VerificarCarrinho() then
        return false
    end

    DefinirStatus(
        "Saindo do Ponto 2"
    )

    if not MoverCarrinho(
        S.ActiveCart,
        FRENTE_PONTO_2,
        PONTO_3
    ) then

        DefinirStatus(
            "Falha ao sair do Ponto 2",
            "error"
        )

        return false
    end

    local finalStage =
        EsperarEstagio(
            {
                [SUFFERED] = true
            }
        )

    return
        S.Running
        and finalStage ==
            SUFFERED
end

