-- ============================================================
-- START / STOP
-- ============================================================

local function StartFarm()
    if S.GuiFechada
        or S.Running then

        return
    end

    S.Running =
        true

    S.CyclesCompleted =
        0

    S.RunStartedAt =
        os.clock()

    S.ActiveCart =
        nil

    S.CurrentStage =
        nil

    S.CurrentStageSource =
        nil

    SetAutoFarmToggleVisual(
        true
    )

    DefinirStatus(
        "Detectando estágio..."
    )

    AdicionarFarmLog(
        "Auto Farm iniciado",
        "success"
    )

    local stage,
        source =
        DetectarEstagioAtual()

    S.CurrentStage =
        stage

    S.CurrentStageSource =
        source

    DefinirVisualEstagio(
        stage,
        source
    )

    S.FarmThread =
        task.spawn(
            function()
                local ok,
                    errorResult =
                    pcall(
                        LoopAutoFarm
                    )

                if not ok
                    and not S.GuiFechada then

                    S.Running =
                        false

                    ResetarEstadoFarm()

                    SetAutoFarmToggleVisual(
                        false
                    )

                    DefinirStatus(
                        "Erro isolado: " ..
                        tostring(
                            errorResult
                        ),
                        "error"
                    )

                    warn(
                        "[CAR RIDE] ERRO NO LOOP:",
                        errorResult
                    )
                end

                S.FarmThread =
                    nil
            end
        )
end

local function StopFarm()
    if S.GuiFechada then
        return
    end

    S.Running =
        false

    if S.DoorTween then
        pcall(function()
            S.DoorTween:Cancel()
        end)

        S.DoorTween =
            nil
    end

    S.ActiveCart =
        nil

    S.CurrentStage =
        nil

    S.CurrentStageSource =
        nil

    UI.FarmDoorLabel.Text =
        "Porta: pronta"

    UI.FarmDoorLabel.TextTransparency =
        0

    UI.FarmDoorBar.Size =
        UDim2.new(
            0,
            0,
            1,
            0
        )

    SetAutoFarmToggleVisual(
        false
    )

    DefinirVisualEstagio(
        nil,
        nil
    )

    DefinirStatus(
        "Auto Farm parado"
    )

    AdicionarFarmLog(
        "Auto Farm desligado",
        "warn"
    )
end

