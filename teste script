local function AtivarInstantInteract()
    if S.InstantInteractEnabled then
        return true
    end

    if not fireproximityprompt then
        SetInstantToggleVisual(
            false
        )

        AdicionarFarmLog(
            "fireproximityprompt indisponível",
            "error"
        )

        return false
    end

    S.InstantInteractEnabled =
        true

    if S.InstantInteractConnection then
        pcall(function()
            S.InstantInteractConnection:Disconnect()
        end)

        S.InstantInteractConnection =
            nil
    end

    local ok,
        connection =
        pcall(
            function()
                return
                    G.ProximityPromptService
                    .PromptButtonHoldBegan
                    :Connect(
                        function(
                            prompt,
                            player
                        )
                            if S.InstantInteractEnabled then
                                pcall(
                                    function()
                                        fireproximityprompt(
                                            prompt
                                        )
                                    end
                                )
                            end
                        end
                    )
            end
        )

    if not ok
        or not connection then

        S.InstantInteractEnabled =
            false

        SetInstantToggleVisual(
            false
        )

        AdicionarFarmLog(
            "Falha ao criar conexão do Instant Interact",
            "error"
        )

        return false
    end

    S.InstantInteractConnection =
        connection

    SetInstantToggleVisual(
        true
    )

    AdicionarFarmLog(
        "Instant Interact ligado",
        "success"
    )

    return true
end

