local stageValues = {
    ["starting"] = "STARTING",
    ["starting to suffer"] = "STARTING",
    ["suffering"] = "SUFFERING",
    ["suffered"] = "SUFFERED"
}

local function FindTextLabelContaining(
    root,
    pattern
)
    if not root then
        return nil
    end

    for _, child in ipairs(
        root:GetDescendants()
    ) do
        if child:IsA("TextLabel") then
            local text =
                tostring(
                    child.Text or ""
                )

            if string.find(
                string.lower(text),
                string.lower(pattern),
                1,
                true
            ) then

                return child
            end
        end
    end

    return nil
end

local stageLabel =
    nil

local cycleLabel =
    nil

local timeLabel =
    nil

if oldStatusPanel then
    stageLabel =
        FindTextLabelContaining(
            oldStatusPanel,
            "NÃO DETECTADO"
        )

    if not stageLabel then
        stageLabel =
            FindTextLabelContaining(
                oldStatusPanel,
                "STARTING"
            )
    end

    cycleLabel =
        FindTextLabelContaining(
            oldStatusPanel,
            "Ciclos:"
        )

    timeLabel =
        FindTextLabelContaining(
            oldStatusPanel,
            "Tempo:"
        )
end

local function ReadStage()
    if not stageLabel then
        return "STARTING"
    end

    local raw =
        string.lower(
            tostring(
                stageLabel.Text or ""
            )
        )

    for key, value in pairs(
        stageValues
    ) do
        if string.find(
            raw,
            key,
            1,
            true
        ) then

            return value
        end
    end

    return "STARTING"
end

local function ReadCycles()
    if not cycleLabel then
        return "0"
    end

    local raw =
        tostring(
            cycleLabel.Text or ""
        )

    local number =
        string.match(
            raw,
            "(%d+)"
        )

    return number
        or "0"
end

local function ReadTime()
    if not timeLabel then
        return "00:00:00"
    end

    local raw =
        tostring(
            timeLabel.Text or ""
        )

    local value =
        string.match(
            raw,
            "(%d+:%d+:%d+)"
        )

    return value
        or "00:00:00"
end

local function IsFarmRunning()
    local api =
        env.CarRideAutoFarm

    if type(api) ~= "table" then
        return false
    end

    if type(api.IsRunning) ~= "function" then
        return false
    end

    local ok,
        result =
        pcall(
            api.IsRunning
        )

    return ok
        and result == true
end

local function UpdateDetailedStatus()
    if destroyed then
        return
    end

    detailTime.Text =
        ReadTime()

    detailCycles.Text =
        ReadCycles()

    local stage =
        ReadStage()

    detailStage.Text =
        stage

    if stage == "SUFFERED" then
        detailStage.TextColor3 =
            Color3.fromRGB(
                87,
                205,
                126
            )
    elseif stage == "SUFFERING" then
        detailStage.TextColor3 =
            Color3.fromRGB(
                251,
                171,
                91
            )
    else
        detailStage.TextColor3 =
            Color3.fromRGB(
                116,
                158,
                255
            )
    end

    if not IsFarmRunning()
        and detailStage.Text ==
        "STARTING" then

        detailStage.TextColor3 =
            Color3.fromRGB(
                104,
                108,
                121
            )
    end
end

