local function AdicionarFarmLog(
    message,
    level
)
    if S.GuiFechada then
        return
    end

    table.insert(
        S.FarmLogEntries,
        {
            text =
                tostring(message),

            time =
                os.date("%H:%M:%S"),

            level =
                level or "info"
        }
    )

    while #S.FarmLogEntries >
        CFG.LOG_LIMIT do

        table.remove(
            S.FarmLogEntries,
            1
        )
    end

    for _, child in ipairs(
        UI.FarmLogScroll:GetChildren()
    ) do

        if child:IsA(
            "TextLabel"
        ) then

            child:Destroy()
        end
    end

    for index, entry in ipairs(
        S.FarmLogEntries
    ) do

        local label =
            Instance.new(
                "TextLabel"
            )

        label.Size =
            UDim2.new(
                1,
                -4,
                0,
                14
            )

        label.BackgroundTransparency =
            1

        label.Font =
            Enum.Font.Gotham

        label.TextSize =
            7

        label.TextXAlignment =
            Enum.TextXAlignment.Left

        label.Text =
            "[" ..
            entry.time ..
            "] " ..
            entry.text

        label.TextTransparency =
            0

        if entry.level ==
            "success" then

            label.TextColor3 =
                C.VERDE

        elseif entry.level ==
            "warn" then

            label.TextColor3 =
                C.LARANJA

        elseif entry.level ==
            "error" then

            label.TextColor3 =
                C.VERMELHO

        elseif entry.level ==
            "stage" then

            label.TextColor3 =
                C.AZUL

        else
            label.TextColor3 =
                C.TEXTO_SECUNDARIO
        end

        label.LayoutOrder =
            index

        label.ZIndex =
            6

        label.Parent =
            UI.FarmLogScroll
    end

    task.defer(function()
        pcall(function()
            UI.FarmLogScroll.CanvasPosition =
                Vector2.new(
                    0,
                    math.max(
                        0,
                        UI.FarmLogLayout.AbsoluteContentSize.Y -
                            UI.FarmLogScroll.AbsoluteWindowSize.Y
                    )
                )
        end)
    end)
end

