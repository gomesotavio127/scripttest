local function EncontrarInteracaoPerto(
    position,
    radius
)
    local best =
        nil

    local bestDistance =
        math.huge

    local ok,
        descendants =
        pcall(function()
            return workspace:GetDescendants()
        end)

    if not ok
        or not descendants then

        return nil
    end

    for _, object in ipairs(
        descendants
    ) do

        if object:IsA(
            "ClickDetector"
        )
            or object:IsA(
                "ProximityPrompt"
            ) then

            local parent =
                object.Parent

            if parent
                and parent:IsA(
                    "BasePart"
                ) then

                local distance =
                    (
                        parent.Position -
                        position
                    ).Magnitude

                if distance <= radius
                    and distance < bestDistance then

                    best =
                        object

                    bestDistance =
                        distance
                end
            end
        end
    end

    return best
end

local function EhVerde(
    part
)
    if not part
        or not part:IsA(
            "BasePart"
        ) then

        return false
    end

    local color =
        part.Color

    return
        color.G >
            color.R * 1.25
        and color.G >
            color.B * 1.15
end

local function EncontrarInteracaoVerde(
    position,
    radius
)
    local candidates =
        {}

    local ok,
        descendants =
        pcall(function()
            return workspace:GetDescendants()
        end)

    if not ok
        or not descendants then

        return nil
    end

    for _, object in ipairs(
        descendants
    ) do

        if object:IsA(
            "ClickDetector"
        )
            or object:IsA(
                "ProximityPrompt"
            ) then

            local parent =
                object.Parent

            if parent
                and parent:IsA(
                    "BasePart"
                ) then

                local distance =
                    (
                        parent.Position -
                        position
                    ).Magnitude

                if distance <= radius
                    and EhVerde(
                        parent
                    ) then

                    table.insert(
                        candidates,
                        {
                            object =
                                object,

                            distance =
                                distance
                        }
                    )
                end
            end
        end
    end

    table.sort(
        candidates,
        function(a, b)
            return
                a.distance <
                b.distance
        end
    )

    return
        candidates[1]
        and candidates[1].object
        or nil
end

local function AtivarInteracao(
    object
)
    if not object then
        return false
    end

    if object:IsA(
        "ClickDetector"
    ) then

        if not fireclickdetector then
            return false
        end

        return pcall(
            function()
                fireclickdetector(
                    object
                )
            end
        )
    end

    if object:IsA(
        "ProximityPrompt"
    ) then

        if not fireproximityprompt then
            return false
        end

        return pcall(
            function()
                fireproximityprompt(
                    object
                )
            end
        )
    end

    return false
end

