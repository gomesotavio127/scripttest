local function ObterListaSpawns(
    stage
)
    local result =
        {}

    for _, position in ipairs(
        NORMAL_SPAWNS
    ) do

        table.insert(
            result,
            position
        )
    end

    if stage ==
        SUFFERING then

        for _, position in ipairs(
            SUFFERING_EXTRA_SPAWNS
        ) do

            table.insert(
                result,
                position
            )
        end
    end

    return result
end

local function EhPecaIndisponivel(
    part
)
    if not part
        or not part:IsA(
            "BasePart"
        ) then

        return false
    end

    local color =
        part.Color

    local brightness =
        (
            color.R +
            color.G +
            color.B
        ) / 3

    local black =
        brightness <=
        0.15

    local red =
        color.R >= 0.18
        and color.R >
            color.G * 1.35
        and color.R >
            color.B * 1.35

    return
        black
        or red
end

local function EncontrarBotaoSpawn(
    position
)
    local best =
        nil

    local bestDistance =
        math.huge

    local ok,
        descendants =
        pcall(function()
            return workspace:GetDescendants()
        end)

    if not ok
        or not descendants then

        return nil
    end

    for _, object in ipairs(
        descendants
    ) do

        if object:IsA(
            "ClickDetector"
        )
            or object:IsA(
                "ProximityPrompt"
            ) then

            local parent =
                object.Parent

            if parent
                and parent:IsA(
                    "BasePart"
                ) then

                local distance =
                    (
                        parent.Position -
                        position
                    ).Magnitude

                if distance <=
                    CFG.SPAWN_RADIUS
                    and distance <
                    bestDistance then

                    best =
                        object

                    bestDistance =
                        distance
                end
            end
        end
    end

    return best
end

local function SpawnDisponivel(
    object
)
    if not object then
        return false
    end

    local part =
        object.Parent

    if not part
        or not part:IsA(
            "BasePart"
        ) then

        return false
    end

    if EhPecaIndisponivel(
        part
    ) then

        return false
    end

    local model =
        part:FindFirstAncestorOfClass(
            "Model"
        )

    if model then
        local ok,
            descendants =
            pcall(function()
                return model:GetDescendants()
            end)

        if ok
            and descendants then

            for _, child in ipairs(
                descendants
            ) do

                if child:IsA(
                    "BasePart"
                ) then

                    local distance =
                        (
                            child.Position -
                            part.Position
                        ).Magnitude

                    if distance <=
                        CFG.MODEL_UNAVAILABLE_RADIUS
                        and
                        EhPecaIndisponivel(
                            child
                        ) then

                        return false
                    end
                end
            end
        end
    end

    return true
end

local function EncontrarSpawnDisponivel(
    stage
)
    local root =
        ObterRoot()

    if not root then
        return nil, nil, nil
    end

    local available =
        {}

    for index, position in ipairs(
        ObterListaSpawns(
            stage
        )
    ) do

        local object =
            EncontrarBotaoSpawn(
                position
            )

        if object
            and SpawnDisponivel(
                object
            ) then

            table.insert(
                available,
                {
                    index =
                        index,

                    position =
                        position,

                    object =
                        object,

                    distance =
                        (
                            root.Position -
                            position
                        ).Magnitude
                }
            )
        end
    end

    table.sort(
        available,
        function(a, b)
            return
                a.distance <
                b.distance
        end
    )

    local chosen =
        available[1]

    if not chosen then
        return nil, nil, nil
    end

    return
        chosen.position,
        chosen.object,
        chosen
end

local function SpawnarCarrinho(
    stage
)
    local root =
        ObterRoot()

    if not root then
        return false
    end

    DefinirStatus(
        "Procurando spawn disponível..."
    )

    local position,
        object,
        data =
        EncontrarSpawnDisponivel(
            stage
        )

    if not position then
        DefinirStatus(
            "Nenhum spawn disponível",
            "warn"
        )

        return false
    end

    local teleported =
        pcall(
            function()
                root.CFrame =
                    CFrame.new(
                        position +
                        Vector3.new(
                            0,
                            CFG.SPAWN_TELEPORT_OFFSET,
                            0
                        )
                    )
            end
        )

    if not teleported then
        DefinirStatus(
            "Falha ao posicionar no spawn",
            "error"
        )

        return false
    end

    task.wait(
        CFG.SPAWN_CONFIRM_DELAY
    )

    local current =
        EncontrarBotaoSpawn(
            position
        )

    if not current
        or not SpawnDisponivel(
            current
        ) then

        DefinirStatus(
            "Spawn ficou indisponível",
            "warn"
        )

        return false
    end

    if not AtivarInteracao(
        current
    ) then

        DefinirStatus(
            "Falha ao clicar no spawn",
            "error"
        )

        return false
    end

    DefinirStatus(
        "Spawn #" ..
        tostring(
            data.index
        ) ..
        " acionado",
        "success"
    )

    task.wait(
        CFG.SPAWN_SETTLE_DELAY
    )

    return true
end

-- ============================================================
-- CARRINHO
-- ============================================================

local function CarrinhoExiste()
    return
        S.ActiveCart ~= nil
        and
        S.ActiveCart.Parent ~= nil
end

local function EncontrarCarrinho()
    local humanoid =
        ObterHumanoid()

    if humanoid
        and humanoid.SeatPart then

        local model =
            humanoid.SeatPart:
            FindFirstAncestorOfClass(
                "Model"
            )

        if model then
            return model
        end
    end

    local root =
        ObterRoot()

    if not root then
        return nil
    end

    local best =
        nil

    local bestDistance =
        math.huge

    local ok,
        descendants =
        pcall(function()
            return workspace:GetDescendants()
        end)

    if not ok
        or not descendants then

        return nil
    end

    for _, object in ipairs(
        descendants
    ) do

        if object:IsA(
            "VehicleSeat"
        )
            or object:IsA(
                "Seat"
            ) then

            local distance =
                (
                    object.Position -
                    root.Position
                ).Magnitude

            if distance <=
                CFG.CART_SEARCH_RADIUS
                and distance <
                bestDistance then

                local model =
                    object:
                    FindFirstAncestorOfClass(
                        "Model"
                    )

                if model then
                    best =
                        model

                    bestDistance =
                        distance
                end
            end
        end
    end

    return best
end

local function EncontrarCarrinhoComRetry()
    DefinirStatus(
        "Procurando carrinho..."
    )

    local started =
        os.clock()

    while S.Running
        and (
            os.clock() -
            started
        ) <
        CFG.CART_FIND_TIMEOUT do

        local cart =
            EncontrarCarrinho()

        if cart then
            return cart
        end

        task.wait(
            CFG.CART_SEARCH_INTERVAL
        )
    end

    return nil
end

local function SentarNoCarrinho(
    cart
)
    if not cart
        or not cart.Parent then

        return false
    end

    local humanoid =
        ObterHumanoid()

    if not humanoid then
        return false
    end

    local seat =
        cart:
        FindFirstChildWhichIsA(
            "VehicleSeat",
            true
        )

    if not seat then
        seat =
            cart:
            FindFirstChildWhichIsA(
                "Seat",
                true
            )
    end

    if not seat then
        return false
    end

    local ok =
        pcall(
            function()
                seat:Sit(
                    humanoid
                )
            end
        )

    if not ok then
        return false
    end

    task.wait(0.7)

    return
        humanoid.SeatPart ==
            seat
        or humanoid.Sit
end

local function MoverCarrinho(
    cart,
    position,
    lookAt
)
    if not cart
        or not cart.Parent then

        return false
    end

    local cframe

    if lookAt then
        cframe =
            CFrame.lookAt(
                position,
                lookAt,
                Vector3.new(
                    0,
                    1,
                    0
                )
            )
    else
        cframe =
            CFrame.new(
                position
            )
    end

    local success =
        false

    pcall(
        function()
            cart:PivotTo(
                cframe
            )

            success =
                true
        end
    )

    if not success
        and cart.PrimaryPart then

        pcall(
            function()
                cart.PrimaryPart.CFrame =
                    cframe

                success =
                    true
            end
        )
    end

    return success
end

local function VerificarCarrinho()
    if not S.Running then
        return false
    end

    if not CarrinhoExiste() then
        DefinirStatus(
            "Carrinho perdido · reiniciando ciclo",
            "warn"
        )

        S.ActiveCart =
            nil

        S.CurrentStage =
            nil

        S.CurrentStageSource =
            nil

        return false
    end

    if not G.Player.Character then
        S.ActiveCart =
            nil

        return false
    end

    if not ObterHumanoid() then
        S.ActiveCart =
            nil

        return false
    end

    return true
end

