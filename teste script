local function FormatarTempo(
    seconds
)
    seconds =
        math.max(
            0,
            math.floor(
                seconds or 0
            )
        )

    local hours =
        math.floor(
            seconds / 3600
        )

    local minutes =
        math.floor(
            (seconds % 3600) / 60
        )

    local secs =
        seconds % 60

    return string.format(
        "%02d:%02d:%02d",
        hours,
        minutes,
        secs
    )
end

local function AtualizarStatusGUI()
