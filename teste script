local connections = {}
local zConnection = nil
local toastGui = nil

local function Connect(signal, callback)
    local ok,
        connection =
        pcall(function()
            return signal:Connect(
                callback
            )
        end)

    if ok and connection then
        table.insert(
            connections,
            connection
        )

        return connection
    end

    return nil
end

local function DisconnectAll()
    for _, connection in ipairs(
        connections
    ) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(
        connections
    )

    if zConnection then
        pcall(function()
            zConnection:Disconnect()
        end)

        zConnection = nil
    end
end

local function DestroyToast()
    if toastGui then
        pcall(function()
            toastGui:Destroy()
        end)

        toastGui = nil
    end
end

