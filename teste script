-- CART RIDE HUB · PATCH
-- Mantém o visual original do script do GitHub e aplica
-- somente as alterações funcionais solicitadas.
-- ============================================================

local SOURCE_URL =
    "https://raw.githubusercontent.com/gomesotavio127/scripttest/main/teste%20script"

local env =
    (getgenv and getgenv()) or _G

pcall(function()
    local oldController =
        env.__CapivaraCarRidePatch

    if oldController
        and type(oldController) == "table"
        and type(oldController.Destroy) == "function" then

        oldController.Destroy()
    end
end)

-- ============================================================
-- CARREGAR SCRIPT ORIGINAL SEM ALTERAR O VISUAL
-- ============================================================

local source

do
    local ok, result =
        pcall(function()
            return game:HttpGet(
                SOURCE_URL
            )
        end)

    if not ok
        or type(result) ~= "string"
        or #result < 1000 then

        error(
            "Não foi possível carregar o script original."
        )
    end

    source = result
end

local chunk,
    compileError =
    loadstring(source)

if type(chunk) ~= "function" then
    error(
        "Erro ao compilar o script original: " ..
        tostring(compileError)
    )
end

local executed,
    executeError =
    pcall(chunk)

if not executed then
    error(
        "Erro ao executar o script original: " ..
        tostring(executeError)
    )
end

