local function CloseHub()
    if S.GuiFechada then
        return
    end

    S.GuiFechada =
        true

    S.Running =
        false

    S.InstantInteractEnabled =
        false

    S.ActiveCart =
        nil

    S.CurrentStage =
        nil

    S.CurrentStageSource =
        nil

    if S.DoorTween then
        pcall(function()
            S.DoorTween:Cancel()
        end)

        S.DoorTween =
            nil
    end

    if S.LoadingSpinnerTween then
        pcall(function()
            S.LoadingSpinnerTween:Cancel()
        end)

        S.LoadingSpinnerTween =
            nil
    end

    if S.InstantInteractConnection then
        pcall(function()
            S.InstantInteractConnection:Disconnect()
        end)

        S.InstantInteractConnection =
            nil
    end

    EncerrarDrag()

    DesconectarTudo()

    pcall(function()
        G.env.CarRideAutoFarm =
            nil
    end)

    pcall(function()
        if UI.BaseFolder then
            UI.BaseFolder:Destroy()
        end
    end)

    pcall(function()
        if UI.ScreenGui then
            UI.ScreenGui:Destroy()
        end
    end)
end

Conectar(
    closeButton.MouseButton1Click,
    CloseHub
)

