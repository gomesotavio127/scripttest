local function MostrarCategoria(
    category,
    instant
)
    if S.GuiFechada
        or not UI.Pages[category] then

        return
    end

    if S.CurrentCategory ==
        category
        and not instant then

        local current =
            UI.Pages[category]

        current.Visible =
            true

        current.GroupTransparency =
            0

        return
    end

    local oldPage =
        UI.Pages[
            S.CurrentCategory
        ]

    local newPage =
        UI.Pages[category]

    S.CurrentCategory =
        category

    headerTitle.Text =
        category

    headerTitle.TextTransparency =
        0

    headerSubtitle.Text =
        CATEGORY_SUBTITLES[
            category
        ] or ""

    headerSubtitle.TextTransparency =
        0

    AtualizarNavVisual(
        category
    )

    if oldPage
        and oldPage ~=
            newPage
        and oldPage.Visible then

        local oldPageReference =
            oldPage

        oldPageReference.GroupTransparency =
            0

        Tween(
            oldPageReference,
            0.13,
            {
                GroupTransparency =
                    1,

                Position =
                    UDim2.new(
                        -0.025,
                        0,
                        0,
                        0
                    )
            },
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.In
        )

        task.delay(
            0.16,
            function()
                if S.GuiFechada then
                    return
                end

                oldPageReference.Visible =
                    false

                oldPageReference.Position =
                    UDim2.new(
                        0,
                        0,
                        0,
                        0
                    )

                oldPageReference.GroupTransparency =
                    0
            end
        )
    end

    newPage.Visible =
        true

    newPage.Position =
        instant
        and UDim2.new(
            0,
            0,
            0,
            0
        )
        or UDim2.new(
            0.025,
            0,
            0,
            0
        )

    if instant then
        newPage.GroupTransparency =
            0

        newPage.Position =
            UDim2.new(
                0,
                0,
                0,
                0
            )

        return
    end

    newPage.GroupTransparency =
        1

    local pageTween =
        Tween(
            newPage,
            0.18,
            {
                GroupTransparency =
                    0,

                Position =
                    UDim2.new(
                        0,
                        0,
                        0,
                        0
                    )
            }
        )

    task.delay(
        pageTween
        and 0.22
        or 0.03,
        function()
            if S.GuiFechada then
                return
            end

            if S.CurrentCategory ~=
                category then

                return
            end

            newPage.Visible =
                true

            newPage.Position =
                UDim2.new(
                    0,
                    0,
                    0,
                    0
                )

            newPage.GroupTransparency =
                0
        end
    )
end

