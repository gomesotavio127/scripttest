-- ============================================================
-- CONEXÕES
-- ============================================================

local function Conectar(signal, callback)
    local ok, connection = pcall(function()
        return signal:Connect(callback)
    end)

    if ok and connection then
        table.insert(
            S.Conexoes,
            connection
        )

        return connection
    end

    return nil
end

local function DesconectarTudo()
    for _, connection in ipairs(
        S.Conexoes
    ) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(
        S.Conexoes
    )

    if S.DragEndConnection then
        pcall(function()
            S.DragEndConnection:Disconnect()
        end)

        S.DragEndConnection =
            nil
    end
end

