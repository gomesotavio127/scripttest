        source or ""
    )

    return stage
end

local function NormalizarEstagioCiclo(
    stage
)
    if VALID_STAGES[stage] then
        return stage
    end

    S.CurrentStage =
        STARTING

    S.CurrentStageSource =
        "Fallback"

    DefinirVisualEstagio(
        STARTING,
        "Fallback"
    )

    AdicionarFarmLog(
        "Estágio não detectado · usando STARTING como fallback",
        "warn"
    )

    return STARTING
end

-- ============================================================
-- SUFFERED DIRETO
-- ============================================================

local function FinalizarSuffered(
    success,
    errorResult
)
    if success then
        S.CyclesCompleted +=
            1

        AdicionarFarmLog(
            "Ciclo concluído!",
            "success"
        )

        DefinirStatus(
            "Ciclo concluído · reiniciando...",
            "success"
        )

    elseif errorResult then
        DefinirStatus(
            "Erro no botão verde: " ..
            tostring(
                errorResult
            ),
            "error"
        )

    else
        DefinirStatus(
            "Ciclo não concluído · recuperando...",
            "warn"
        )
    end

    ResetarEstadoFarm()

    if S.Running then
        task.wait(
            CFG.POST_CYCLE_DELAY
        )
    end
end

local function ProcessarSufferedDireto()
    DefinirStatus(
        "Suffered → Ponto 3"
    )

    local ok,
        result =
        pcall(
            PressionarBotaoVerde
        )

    FinalizarSuffered(
        ok and result == true,
        ok and nil or result
    )
end

-- ============================================================
-- HANDLE SPAWN
-- ============================================================

local function HandleSpawn(
    stage
)
    local success =
        false

    for attempt =
        1,
        CFG.MAX_RETRIES do

        if not S.Running then
            return false
        end

        DefinirStatus(
            "Spawn · tentativa " ..
            tostring(attempt) ..
            "/" ..
            tostring(
                CFG.MAX_RETRIES
            )
        )

        local ok,
            result =
            pcall(
                function()
                    return SpawnarCarrinho(
                        stage
                    )
                end
            )

        if ok and result then
            success =
                true

            break
        end

        if not ok then
            DefinirStatus(
                "Erro no spawn: " ..
                tostring(
                    result
                ),
                "error"
            )
        end

        if attempt <
            CFG.MAX_RETRIES then

            task.wait(0.5)
        end
    end

    if not success then
        DefinirStatus(
            "Spawn falhou após " ..
            tostring(
                CFG.MAX_RETRIES
            ) ..
            " tentativas",
            "error"
        )

        ResetarEstadoFarm()

        task.wait(0.5)

        return false
    end

    return true
end

-- ============================================================
-- HANDLE CART
-- ============================================================

local function HandleCart()
    local cart

    local ok,
        result =
        pcall(
            EncontrarCarrinhoComRetry
        )

    if ok then
        cart =
            result
    else
        DefinirStatus(
            "Erro procurando carrinho: " ..
            tostring(
                result
            ),
            "error"
        )
    end

    if not S.Running then
        return false
    end

    if not cart then
        DefinirStatus(
            "Carrinho não encontrado após " ..
            tostring(
                CFG.CART_FIND_TIMEOUT
            ) ..
            "s",
            "error"
        )

        ResetarEstadoFarm()

        task.wait(0.5)

        return false
    end

    S.ActiveCart =
        cart

    DefinirStatus(
        "Carrinho encontrado",
        "success"
    )

    local sitOk,
        sitResult =
        pcall(
            function()
                return SentarNoCarrinho(
                    S.ActiveCart
                )
            end
        )

    if not sitOk then
        DefinirStatus(
            "Erro ao sentar no carrinho: " ..
            tostring(
                sitResult
            ),
            "error"
        )

    elseif not sitResult then
        DefinirStatus(
            "Assento não confirmado",
            "warn"
        )
    end

    return
        S.Running
        and CarrinhoExiste()
end

-- ============================================================
-- HANDLE ROUTE
-- ============================================================

local function HandleRoute(
    stage
)
    if not VerificarCarrinho() then
        return false
    end

    local ok,
        result

    if stage ==
        STARTING then

        ok,
            result =
            pcall(
                ExecutarStarting
            )

    elseif stage ==
        SUFFERING then

        ok,
            result =
            pcall(
                ExecutarSuffering
            )

    else
        return false
    end

    if not ok then
        DefinirStatus(
            "Erro na rota: " ..
            tostring(
                result
            ),
            "error"
        )

        ResetarEstadoFarm()

        task.wait(0.5)

        return false
    end

    if not result then
        ResetarEstadoFarm()

        task.wait(0.5)

        return false
    end

    return true
end

-- ============================================================
-- HANDLE GREEN
-- ============================================================

local function HandleGreenButton()
    local stage,
        source =
        DetectarEstagioAtual()

    S.CurrentStage =
        stage

    S.CurrentStageSource =
        source

    DefinirVisualEstagio(
        stage,
        source
    )

    if stage ==
        SUFFERED then

        local ok,
            result =
            pcall(
                PressionarBotaoVerde
            )

        if ok and result then
            S.CyclesCompleted +=
                1

            AdicionarFarmLog(
                "Ciclo concluído!",
                "success"
            )

            return true
        end

        if not ok then
            DefinirStatus(
                "Erro no botão verde: " ..
                tostring(
                    result
                ),
                "error"
            )
        end

        return false
    end

    local expected =
        EsperarEstagio(
            {
                [SUFFERED] = true
            }
        )

    if not S.Running
        or expected ~=
        SUFFERED then

        return false
    end

    local ok,
        result =
        pcall(
            PressionarBotaoVerde
        )

    if ok and result then
        S.CyclesCompleted +=
            1

        AdicionarFarmLog(
            "Ciclo concluído!",
            "success"
        )

        return true
    end

    if not ok then
        DefinirStatus(
            "Erro no botão verde: " ..
            tostring(
                result
            ),
            "error"
        )
    end

    return false
end

-- ============================================================
-- FINALIZAR CICLO
-- ============================================================

local function HandleCycleFinish(
    success
)
    if success then
        DefinirStatus(
            "Ciclo concluído · reiniciando...",
            "success"
        )
    else
        DefinirStatus(
            "Ciclo não concluído · recuperando...",
            "warn"
        )
    end

    ResetarEstadoFarm()

    task.wait(
        CFG.POST_CYCLE_DELAY
    )
end

-- ============================================================
-- EXECUTAR CICLO
-- ============================================================

local function ExecutarCiclo()
    local stage =
        ObterEstagioDeCiclo()

    if stage ==
        SUFFERED then

        ProcessarSufferedDireto()

        return
    end

    stage =
        NormalizarEstagioCiclo(
            stage
        )

    if not HandleSpawn(
        stage
    ) then

        return
    end

    if not HandleCart() then
        return
    end

    if not HandleRoute(
        stage
    ) then

        return
    end

    if not S.Running then
        return
    end

    local success =
        HandleGreenButton()

    HandleCycleFinish(
        success
    )
end

-- ============================================================
-- LOOP PRINCIPAL
-- ============================================================

local function LoopAutoFarm()
    while S.Running do
        local ok,
            errorResult =
            pcall(
                ExecutarCiclo
            )

        if not ok then
            DefinirStatus(
                "Erro recuperável: " ..
                tostring(
                    errorResult
                ),
                "error"
            )

            warn(
                "[CAR RIDE] ERRO RECUPERÁVEL:",
                errorResult
            )

            ResetarEstadoFarm()

            if S.Running then
                task.wait(0.5)
            end
        end
    end

    if not S.GuiFechada then
        DefinirStatus(
            "Auto Farm parado"
        )
    end
end

