    end
end

local function MinimizeHub()
    if destroyed
        or minimized
        or not screenGui
        or not screenGui.Parent then

        return
    end

    minimized =
        true

    HideRestoreResidue()

    pcall(function()
        if window then
            window.Visible =
                false
        end
    end)

    screenGui.Enabled =
        false

    ShowToast()
end

local function RestoreHub()
    if destroyed
        or not minimized
        or not screenGui
        or not screenGui.Parent then

        return
    end

    minimized =
        false

    screenGui.Enabled =
        true

    HideRestoreResidue()

    pcall(function()
        if window then
            window.Visible =
                true

            window.BackgroundTransparency =
                0
        end
    end)

    task.defer(
        UpdateDetailedStatus
    )
end

if minimizeButton then
    Connect(
        minimizeButton.Activated,
        function()
            task.defer(
                MinimizeHub
