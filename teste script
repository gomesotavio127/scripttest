-- DETECÇÃO DE ESTÁGIO
-- ============================================================

local function Normalizar(
    value
)
    if value == nil then
        return ""
    end

    local ok,
        result =
        pcall(function()
            return string.lower(
                tostring(value)
            )
        end)

    return
        ok
        and result
        or ""
end

local function ObterEstagioPeloTexto(
    value
)
    local text =
        Normalizar(value)

    if text == "" then
        return nil
    end

    if string.find(
        text,
        STARTING,
        1,
        true
    ) then

        return STARTING
    end

    if string.find(
        text,
        SUFFERING,
        1,
        true
    ) then

        return SUFFERING
    end

    if string.find(
        text,
        SUFFERED,
        1,
        true
    ) then

        return SUFFERED
    end

    return nil
end

local PLAYER_NAME =
    Normalizar(
        G.Player.Name
    )

local PLAYER_DISPLAY =
    Normalizar(
        G.Player.DisplayName
    )

local function ContemJogador(
    value
)
    local text =
        Normalizar(value)

    if text == "" then
        return false
    end

    if PLAYER_NAME ~= ""
        and string.find(
            text,
            PLAYER_NAME,
            1,
            true
        ) then

        return true
    end

    if PLAYER_DISPLAY ~= ""
        and string.find(
            text,
            PLAYER_DISPLAY,
            1,
            true
        ) then

        return true
    end

    return false
end

local function ObterTextoObjeto(
    object
)
    if not object then
        return nil
    end

    if object:IsA(
        "TextLabel"
    )
        or object:IsA(
            "TextButton"
        )
        or object:IsA(
            "TextBox"
        ) then

        return object.Text
    end

    if object:IsA(
        "StringValue"
    ) then

        return object.Value
    end

    return nil
end

local function AtributosContemJogador(
    object
)
    local ok,
        attributes =
        pcall(function()
            return object:GetAttributes()
        end)

    if not ok
        or not attributes then

        return false
    end

    for _, value in pairs(
        attributes
    ) do

        if type(value) ==
            "string"
            and ContemJogador(
                value
            ) then

            return true
        end
    end

    return false
end

local function ObterEstagioDoTeam()
    local team =
        G.Player.Team

    if team then
        local stage =
            ObterEstagioPeloTexto(
                team.Name
            )

        if stage then
            return
                stage,
                "Team: " ..
                tostring(
                    team.Name
                )
        end
    end

    return nil, nil
end

local function EncontrarEstagioNoContainer(
    container
)
    if not container then
        return nil, nil
    end

    local ok,
        descendants =
        pcall(function()
            return container:GetDescendants()
        end)

    if not ok
        or not descendants then

        return nil, nil
    end

    for _, object in ipairs(
        descendants
    ) do

        local nameText =
            Normalizar(
                object.Name
            )

        local objectText =
            ObterTextoObjeto(
                object
            )

        local playerFound =
            ContemJogador(
                nameText
            )

        if not playerFound
            and objectText then

            playerFound =
                ContemJogador(
                    objectText
                )
        end

        if not playerFound then
            playerFound =
                AtributosContemJogador(
                    object
                )
        end

        if playerFound then
            local stage =
                ObterEstagioPeloTexto(
                    object.Name
                )

            if stage then
                return
                    stage,
                    object:GetFullName()
            end

            if objectText then
                stage =
                    ObterEstagioPeloTexto(
                        objectText
                    )

                if stage then
                    return
                        stage,
                        object:GetFullName()
                end
            end

            local parent =
                object.Parent

            for _ = 1, 10 do
                if not parent then
                    break
                end

                stage =
                    ObterEstagioPeloTexto(
                        parent.Name
                    )

                if stage then
                    return
                        stage,
                        parent:GetFullName()
                end

                local parentText =
                    ObterTextoObjeto(
                        parent
                    )

                if parentText then
                    stage =
                        ObterEstagioPeloTexto(
                            parentText
                        )

                    if stage then
                        return
                            stage,
                            parent:GetFullName()
                    end
                end

                if AtributosContemJogador(
                    parent
                ) then

                    stage =
                        ObterEstagioPeloTexto(
                            parent.Name
                        )

                    if stage then
                        return
                            stage,
                            parent:GetFullName()
                    end

                    local attributeText =
                        ObterTextoObjeto(
                            parent
                        )

                    if attributeText then
                        stage =
                            ObterEstagioPeloTexto(
                                attributeText
                            )

                        if stage then
                            return
                                stage,
                                parent:GetFullName()
                        end
                    end
                end

                parent =
                    parent.Parent
            end
        end
    end

    return nil, nil
end

local function DetectarEstagioAtual()
    local stage,
        source =
        ObterEstagioDoTeam()

    if stage then
        return stage, source
    end

    local playerGui =
        G.Player:FindFirstChildOfClass(
            "PlayerGui"
        )

    stage,
        source =
        EncontrarEstagioNoContainer(
