local function Hover(
    button,
    normal,
    hover
)
    Conectar(
        button.MouseEnter,
        function()
            if not S.GuiFechada then
                Tween(
                    button,
                    0.14,
                    {
                        BackgroundColor3 =
                            hover
                    }
                )
            end
        end
    )

    Conectar(
        button.MouseLeave,
        function()
            if not S.GuiFechada then
                Tween(
                    button,
                    0.14,
                    {
                        BackgroundColor3 =
                            normal
                    }
                )
            end
        end
    )
end

local function PressEffect(
    button,
    normal,
    pressed
)
    Conectar(
        button.MouseButton1Down,
        function()
            if not S.GuiFechada then
                Tween(
                    button,
                    0.06,
                    {
                        BackgroundColor3 =
                            pressed
                    }
                )
            end
        end
    )

    Conectar(
        button.MouseButton1Up,
        function()
            if not S.GuiFechada then
                Tween(
                    button,
                    0.08,
                    {
                        BackgroundColor3 =
                            normal
                    }
                )
            end
        end
    )
end

