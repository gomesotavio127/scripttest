local function MinimizarHub()
    if S.GuiFechada
        or S.Minimized then

        return
    end

    S.Minimized =
        true

    EncerrarDrag()

    Tween(
        UI.WindowScale,
        0.17,
        {
            Scale =
                0.9
        },
        Enum.EasingStyle.Back,
        Enum.EasingDirection.In
    )

    task.delay(
        0.18,
        function()
            if S.GuiFechada
                or not S.Minimized then

                return
            end

            UI.Window.Visible =
                false

            restorePill.Visible =
                true

            restorePill.BackgroundTransparency =
                0
        end
    )
end

local function RestaurarHub()
    if S.GuiFechada
        or not S.Minimized then

        return
    end

    S.Minimized =
        false

    restorePill.Visible =
        false

    UI.Window.Visible =
        true

    UI.WindowScale.Scale =
        0.9

    ForcarTodasPaginasVisiveis()

    Tween(
        UI.WindowScale,
        0.22,
        {
            Scale =
                1
        },
        Enum.EasingStyle.Back
    )

    task.delay(
        0.25,
        function()
            if S.GuiFechada
                or S.Minimized then

                return
            end

            UI.Window.Visible =
                true

            UI.WindowScale.Scale =
                1

            if UI.Pages[
                S.CurrentCategory
            ] then

                UI.Pages[
                    S.CurrentCategory
                ].Visible =
                    true

                UI.Pages[
                    S.CurrentCategory
                ].GroupTransparency =
                    0
            end
        end
    )
end

